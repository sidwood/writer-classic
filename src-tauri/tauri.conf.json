{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writer Classic",
  "version": "0.1.0",
  "identifier": "com.sidwood.writer-classic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && python3 scripts/build-macos-extras.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Untitled",
        "width": 735,
        "height": 615,
        "minWidth": 560,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../brand/markdown-document-icon.icns": "markdown-document-icon.icns",
      "WriterClassic.sdef": "WriterClassic.sdef"
    },
    "category": "Productivity",
    "shortDescription": "A classic plain-text writing environment",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "files": {
        "Library/QuickLook/Writer Classic.qlgenerator": "target/quicklook/Writer Classic.qlgenerator",
        "PlugIns/WriterClassicPreview.appex": "target/quicklook/WriterClassicPreview.appex",
        "Resources/WriterClassicHelp": "target/help/WriterClassicHelp",
        "Resources/WriterClassicSuite.scriptSuite": "target/help/WriterClassicSuite.scriptSuite",
        "Resources/WriterClassicSuite.scriptTerminology": "target/help/WriterClassicSuite.scriptTerminology"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt",
          "text",
          "mmd",
          "multimarkdown",
          "mdown",
          "mkdn",
          "mkd",
          "mdwn",
          "mdtxt",
          "mdtext",
          "mdml",
          "docx"
        ],
        "role": "Editor",
        "name": "Text document"
      }
    ]
  }
}
